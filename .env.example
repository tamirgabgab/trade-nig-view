# ChartLab environment configuration.
# Copy to `.env` (never commit `.env`). All keys are OPTIONAL: without them ChartLab
# uses yfinance (no key) and the committed offline fixtures.

# --- Runtime mode ---
# OFFLINE=1 serves committed CSV fixtures only and never touches the network.
OFFLINE=0
# Where the SQLite databases (metadata + bar cache) live. Relative to repo root.
CHARTLAB_DATA_DIR=./data
# Backend bind address
CHARTLAB_HOST=127.0.0.1
CHARTLAB_PORT=8000
# Frontend dev server origin allowed by CORS
CHARTLAB_CORS_ORIGINS=http://localhost:5173

# --- Data providers ---
# Order in which providers are tried for a symbol (comma separated ids).
DATA_PROVIDERS=yahoo,tiingo,twelvedata
# Tiingo (free tier: EOD stocks/ETFs; ~50 req/hour, 1,000 req/day). https://api.tiingo.com
TIINGO_API_KEY=
# Twelve Data (free "Basic": 8 credits/min, 800/day, internal non-display use only).
TWELVEDATA_API_KEY=
# Massive, formerly Polygon.io (free "Basic": 5 calls/min, EOD, ~2 years history).
MASSIVE_API_KEY=
# Stooq (CSV download requires an API key obtained via captcha since 2026).
STOOQ_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
