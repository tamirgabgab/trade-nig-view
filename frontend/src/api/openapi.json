{
  "openapi": "3.1.0",
  "info": {
    "title": "ChartLab API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Report that the API is up, its version, offline mode and the active data providers.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/symbols": {
      "get": {
        "tags": [
          "symbols"
        ],
        "summary": "List Symbols",
        "description": "Symbols in universe order (which is also the default watchlist order).",
        "operationId": "list_symbols_api_symbols_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50,
              "description": "Substring of symbol or name",
              "default": "",
              "title": "Query"
            },
            "description": "Substring of symbol or name"
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Watchlist section, e.g. 'Stocks'",
              "title": "Group"
            },
            "description": "Watchlist section, e.g. 'Stocks'"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SymbolInfo"
                  },
                  "title": "Response List Symbols Api Symbols Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/bars": {
      "get": {
        "tags": [
          "bars"
        ],
        "summary": "Get Bars",
        "description": "The newest ``limit`` bars in ``[start, end]`` (and before ``before``), never after\n``until``.\n\nFor intraday intervals the dates select whole trading sessions (by session date).",
        "operationId": "get_bars_api_bars_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "title": "Symbol"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Interval",
              "default": "1D"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Replay cursor: no bar after it",
              "title": "Until"
            },
            "description": "Replay cursor: no bar after it"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50000,
              "minimum": 1,
              "default": 5000,
              "title": "Limit"
            }
          },
          {
            "name": "adjusted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Adjusted"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Paging: only bars that start before this UTC epoch second (exclusive). Pass the oldest loaded bar's time; a daily date counts as 00:00 UTC.",
              "title": "Before"
            },
            "description": "Paging: only bars that start before this UTC epoch second (exclusive). Pass the oldest loaded bar's time; a daily date counts as 00:00 UTC."
          },
          {
            "name": "transform",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Transform",
              "default": "none"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BarsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/quotes": {
      "get": {
        "tags": [
          "quotes"
        ],
        "summary": "Get Quotes",
        "description": "Unadjusted last close vs previous close. Per-symbol failures are reported in ``error``.",
        "operationId": "get_quotes_api_quotes_get",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Comma-separated, e.g. 'AAPL,^GSPC'",
              "title": "Symbols"
            },
            "description": "Comma-separated, e.g. 'AAPL,^GSPC'"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuoteOut"
                  },
                  "title": "Response Get Quotes Api Quotes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/indicators": {
      "get": {
        "tags": [
          "indicators"
        ],
        "summary": "List Indicators",
        "description": "Every registered indicator with its inputs and outputs (the UI is generated from this).",
        "operationId": "list_indicators_api_indicators_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IndicatorInfo"
                  },
                  "type": "array",
                  "title": "Response List Indicators Api Indicators Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/indicators/compute": {
      "post": {
        "tags": [
          "indicators"
        ],
        "summary": "Compute Indicator",
        "description": "Indicator values for the bars in ``[start, end]``.\n\n``lookback = max(25 n, 250)`` extra bars before ``start`` are loaded so the first returned\nvalues are warmed up exactly as in a full-history computation (ARCHITECTURE section 3.2).",
        "operationId": "compute_indicator_api_indicators_compute_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComputeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComputeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Bar": {
        "properties": {
          "time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Time",
            "description": "Daily and longer: session date 'YYYY-MM-DD'. Intraday (1h, 4h): UTC epoch seconds of the bar start."
          },
          "open": {
            "type": "number",
            "title": "Open"
          },
          "high": {
            "type": "number",
            "title": "High"
          },
          "low": {
            "type": "number",
            "title": "Low"
          },
          "close": {
            "type": "number",
            "title": "Close"
          },
          "volume": {
            "type": "number",
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "time",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "Bar"
      },
      "BarsResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "interval": {
            "$ref": "#/components/schemas/Interval"
          },
          "adjusted": {
            "type": "boolean",
            "title": "Adjusted",
            "description": "Dividend adjustment applied (ADJ)"
          },
          "transform": {
            "$ref": "#/components/schemas/Transform",
            "description": "Bar transform applied (e.g. Heikin Ashi)"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "description": "Exchange time zone (IANA), e.g. 'America/New_York'"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Provider that delivered the cached data"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "description": "True if a refresh failed and cached data is served"
          },
          "has_more_before": {
            "type": "boolean",
            "title": "Has More Before",
            "description": "Older bars exist (request with an earlier end)"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "bars": {
            "items": {
              "$ref": "#/components/schemas/Bar"
            },
            "type": "array",
            "title": "Bars"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "interval",
          "adjusted",
          "transform",
          "timezone",
          "source",
          "stale",
          "has_more_before",
          "warnings",
          "bars"
        ],
        "title": "BarsResponse"
      },
      "ComputeRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Symbol"
          },
          "interval": {
            "$ref": "#/components/schemas/Interval",
            "default": "1D"
          },
          "id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Id",
            "description": "Indicator id"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Params",
            "description": "Missing parameters use defaults"
          },
          "start": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start",
            "description": "First bar to return: UTC epoch seconds of its start, inclusive"
          },
          "end": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "Last bar to return: UTC epoch seconds of its start, inclusive"
          },
          "until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until",
            "description": "Replay cursor: no bar after it"
          },
          "adjusted": {
            "type": "boolean",
            "title": "Adjusted",
            "default": true
          },
          "transform": {
            "$ref": "#/components/schemas/Transform",
            "default": "none"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "id"
        ],
        "title": "ComputeRequest"
      },
      "ComputeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "params": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Params",
            "description": "Parameters used (defaults filled in)"
          },
          "time": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Time",
            "description": "Bar times, as in /api/bars ('YYYY-MM-DD' or UTC epoch seconds)"
          },
          "outputs": {
            "additionalProperties": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "object",
            "title": "Outputs",
            "description": "One value per bar in `time`; null during warm-up"
          },
          "warmup": {
            "type": "integer",
            "title": "Warmup",
            "description": "Bars without a value at the start of the full history"
          },
          "lookback": {
            "type": "integer",
            "title": "Lookback",
            "description": "Extra history bars loaded before `start`"
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "params",
          "time",
          "outputs",
          "warmup",
          "lookback"
        ],
        "title": "ComputeResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "offline": {
            "type": "boolean",
            "title": "Offline"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderStatus"
            },
            "type": "array",
            "title": "Providers"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "offline",
          "providers"
        ],
        "title": "HealthResponse",
        "description": "Response body of ``GET /api/health``."
      },
      "IndicatorInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Stable id, used in layouts and tests"
          },
          "version": {
            "type": "integer",
            "title": "Version",
            "description": "Bumped when the output semantics change"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "short_name": {
            "type": "string",
            "title": "Short Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "moving_averages",
              "bands",
              "oscillators",
              "volatility",
              "volume",
              "structure"
            ],
            "title": "Category"
          },
          "overlay": {
            "type": "boolean",
            "title": "Overlay",
            "description": "True: drawn on the price pane; false: own pane"
          },
          "inputs": {
            "items": {
              "type": "string",
              "enum": [
                "open",
                "high",
                "low",
                "close",
                "volume"
              ]
            },
            "type": "array",
            "title": "Inputs"
          },
          "params": {
            "items": {
              "$ref": "#/components/schemas/ParamInfo"
            },
            "type": "array",
            "title": "Params"
          },
          "outputs": {
            "items": {
              "$ref": "#/components/schemas/OutputInfo"
            },
            "type": "array",
            "title": "Outputs"
          },
          "levels": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Levels"
          },
          "learn_slug": {
            "type": "string",
            "title": "Learn Slug",
            "description": "docs/indicators/<learn_slug>.md"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "short_name",
          "category",
          "overlay",
          "inputs",
          "params",
          "outputs",
          "levels",
          "learn_slug",
          "description"
        ],
        "title": "IndicatorInfo"
      },
      "Interval": {
        "type": "string",
        "enum": [
          "1h",
          "4h",
          "1D",
          "1W",
          "1M"
        ],
        "title": "Interval",
        "description": "Bar intervals served by the API.\n\n``1h`` and ``1D`` are downloaded (the *base* intervals); ``4h`` is resampled from ``1h`` and\n``1W``/``1M`` from ``1D``."
      },
      "OutputInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "plot": {
            "type": "string",
            "enum": [
              "line",
              "histogram",
              "area",
              "markers"
            ],
            "title": "Plot"
          },
          "color": {
            "type": "string",
            "title": "Color",
            "description": "Default colour (#RRGGBB)"
          },
          "line_width": {
            "type": "integer",
            "title": "Line Width"
          },
          "style": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Style"
          }
        },
        "type": "object",
        "required": [
          "name",
          "label",
          "plot",
          "color",
          "line_width"
        ],
        "title": "OutputInfo"
      },
      "ParamInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "int",
              "float",
              "bool",
              "enum",
              "source"
            ],
            "title": "Type"
          },
          "default": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Default"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          },
          "step": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "default",
          "label"
        ],
        "title": "ParamInfo"
      },
      "ProviderStatus": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "id",
          "enabled"
        ],
        "title": "ProviderStatus",
        "description": "One market-data provider in the active chain (in priority order)."
      },
      "QuoteOut": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "last": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last"
          },
          "change": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change"
          },
          "change_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Pct"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "time",
          "last",
          "change",
          "change_pct",
          "stale",
          "error"
        ],
        "title": "QuoteOut"
      },
      "SymbolInfo": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "description": "Provider symbol, e.g. 'AAPL', '^GSPC', 'GC=F'"
          },
          "display": {
            "type": "string",
            "title": "Display",
